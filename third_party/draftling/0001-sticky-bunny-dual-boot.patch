+    bool both = gpio_get_level((gpio_num_t)BTN_UP_PIN) == 0 &&
+                gpio_get_level((gpio_num_t)BTN_DOWN_PIN) == 0;
+    if (!both) {
+        chord_ticks = 0;
+        chord_fired = false;
+    } else if (!chord_fired && ++chord_ticks >= BTN_LONG_PRESS_TICKS) {
+        chord_fired = true;
+        xTaskCreate(return_to_bunny_task, "to_bunny", 6144, NULL, 5, NULL);
+    }
+    if (chord_ticks > 0) return;  /* no page turns while chording */
     btn_keys_poll(kButtons, st, 2, 2);
 }
 
