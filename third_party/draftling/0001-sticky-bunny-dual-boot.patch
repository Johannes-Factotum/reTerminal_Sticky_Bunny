+/* ---- Dual-boot with Sticky Bunny ----
+ * Sticky Bunny lives in ota_0 and this firmware in ota_1 (see Sticky
+ * Bunny's partitions.csv). Returning saves every open document, wipes
+ * the panel, points the boot slot at ota_0 and restarts. */
+static void return_to_bunny(void)
+{
+    const esp_partition_t *bunny = esp_partition_find_first(
+        ESP_PARTITION_TYPE_APP, ESP_PARTITION_SUBTYPE_APP_OTA_0, NULL);
+    if (!bunny || bunny == esp_ota_get_running_partition()) {
+        ESP_LOGW(TAG, "Back to Bunny: no Sticky Bunny image in ota_0");
+        return;
+    }
+    esp_app_desc_t desc;
+    if (esp_ota_get_partition_description(bunny, &desc) != ESP_OK) {
+        ESP_LOGW(TAG, "Back to Bunny: ota_0 holds no valid image");
+        return;
+    }
+    pre_sleep_autosave();
+    esp_err_t err = esp_ota_set_boot_partition(bunny);
+    ESP_LOGI(TAG, "Back to Bunny: %s", esp_err_to_name(err));
+    if (err == ESP_OK) esp_restart();
+}
+
+static void return_to_bunny_task(void *arg)
+{
+    (void)arg;
+    return_to_bunny();
+    vTaskDelete(NULL);
+}
